{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Crust & Q — Bright Artisanal Light Theme Tokens",
  "version": "2.0.0",
  "color": {
    "ground": {
      "base": { "value": "#F8F9FA", "type": "color", "description": "Soft porcelain clean background" },
      "secondary": { "value": "#FFFFFF", "type": "color", "description": "Pure crisp white for sections and cards" },
      "card": { "value": "#FFFFFF", "type": "color", "description": "Pure white card surface with tactile depth" },
      "cardElevated": { "value": "#FFFFFF", "type": "color", "description": "Elevated modal and bottom sheet surface with deep blur shadow" },
      "input": { "value": "#F3F4F6", "type": "color", "description": "Subtle gray for search inputs and text fields" },
      "skeleton": { "value": "#E5E7EB", "type": "color", "description": "Loading shimmer base" }
    },
    "border": {
      "subtle": { "value": "#E5E7EB", "type": "color", "description": "Subtle border line for cards and dividers" },
      "strong": { "value": "#D1D5DB", "type": "color", "description": "Active or focused border" }
    },
    "brand": {
      "primary": { "value": "#D93B18", "type": "color", "description": "Vibrant Flame Ember for primary CTAs and cart pills" },
      "primaryHover": { "value": "#C02E0E", "type": "color", "description": "Pressed flame ember" },
      "secondary": { "value": "#D97706", "type": "color", "description": "Golden Crust for star ratings and promo highlights" },
      "accentLight": { "value": "#FFF1EE", "type": "color", "description": "Warm flame tint for active category pills and badges" }
    },
    "feedback": {
      "positive": { "value": "#16A34A", "type": "color", "description": "Fresh parsley green for ratings and veg badges" },
      "positiveBg": { "value": "#F0FDF4", "type": "color", "description": "Muted green badge background" },
      "error": { "value": "#DC2626", "type": "color", "description": "Crimson for validation errors" },
      "errorBg": { "value": "#FEF2F2", "type": "color", "description": "Muted error badge background" },
      "warning": { "value": "#D97706", "type": "color", "description": "Amber for alerts" },
      "warningBg": { "value": "#FFFBEB", "type": "color", "description": "Muted warning badge background" }
    },
    "text": {
      "primary": { "value": "#111827", "type": "color", "description": "Deep obsidian primary text" },
      "secondary": { "value": "#4B5563", "type": "color", "description": "Neutral slate secondary text" },
      "tertiary": { "value": "#9CA3AF", "type": "color", "description": "Muted helper copy" },
      "inverse": { "value": "#FFFFFF", "type": "color", "description": "White text on primary flame buttons" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "Inter, -apple-system, system-ui, sans-serif", "type": "fontFamily" }
    },
    "scale": {
      "display": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "32px", "fontWeight": 700, "lineHeight": "38px" },
      "headlineLarge": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "24px", "fontWeight": 700, "lineHeight": "30px" },
      "headlineMedium": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "20px", "fontWeight": 600, "lineHeight": "26px" },
      "title": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "17px", "fontWeight": 600, "lineHeight": "22px" },
      "bodyLarge": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "22px" },
      "bodyRegular": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px" },
      "caption": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "16px" },
      "footnote": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "11px", "fontWeight": 600, "lineHeight": "14px" }
    }
  },
  "spacing": {
    "4": { "value": "4px", "type": "dimension" },
    "8": { "value": "8px", "type": "dimension" },
    "12": { "value": "12px", "type": "dimension" },
    "16": { "value": "16px", "type": "dimension" },
    "20": { "value": "20px", "type": "dimension" },
    "24": { "value": "24px", "type": "dimension" },
    "32": { "value": "32px", "type": "dimension" },
    "48": { "value": "48px", "type": "dimension" },
    "64": { "value": "64px", "type": "dimension" }
  },
  "radii": {
    "button": { "value": "16px", "type": "dimension" },
    "card": { "value": "20px", "type": "dimension" },
    "chip": { "value": "999px", "type": "dimension" },
    "modal": { "value": "28px", "type": "dimension" }
  },
  "touchErgonomics": {
    "ios": { "minSize": "44px" },
    "android": { "minSize": "48px" }
  },
  "viewports": {
    "ios": { "width": 393, "height": 852, "safeAreaTop": 59, "safeAreaBottom": 34, "device": "iPhone 16 Pro" },
    "android": { "width": 412, "height": 915, "safeAreaTop": 40, "safeAreaBottom": 24, "device": "Android 15 (Pixel 9)" }
  }
}
