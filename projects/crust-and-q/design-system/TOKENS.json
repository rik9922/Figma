{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Crust & Q — Char & Crust Design Tokens",
  "version": "1.0.0",
  "color": {
    "ground": {
      "base": { "value": "#141312", "type": "color", "description": "Deep smoked cast-iron background" },
      "secondary": { "value": "#1E1B18", "type": "color", "description": "Warm charcoal slate for sections" },
      "card": { "value": "#26221E", "type": "color", "description": "Toasted hearth container for food cards" },
      "cardElevated": { "value": "#2E2A25", "type": "color", "description": "Elevated modal and bottom sheet surface" },
      "skeleton": { "value": "#342F2A", "type": "color", "description": "Loading shimmer base" }
    },
    "border": {
      "subtle": { "value": "#332D27", "type": "color", "description": "Subtle container border" },
      "strong": { "value": "#4A423A", "type": "color", "description": "Focused or active border" }
    },
    "brand": {
      "primary": { "value": "#FF5C1A", "type": "color", "description": "Flame Ember Orange for primary CTAs and active states" },
      "primaryHover": { "value": "#E0480A", "type": "color", "description": "Pressed flame ember" },
      "secondary": { "value": "#F2A93B", "type": "color", "description": "Golden Crust for promo badges and star ratings" },
      "accentMuted": { "value": "#382318", "type": "color", "description": "Deep flame tint for active pill background" }
    },
    "feedback": {
      "positive": { "value": "#2E7D32", "type": "color", "description": "Fresh parsley green for ratings and veg badges" },
      "positiveBg": { "value": "#1A2E1C", "type": "color", "description": "Muted green badge background" },
      "error": { "value": "#D32F2F", "type": "color", "description": "Crimson for validation errors" },
      "errorBg": { "value": "#331616", "type": "color", "description": "Muted error badge background" },
      "warning": { "value": "#F57C00", "type": "color", "description": "Amber for alerts" },
      "warningBg": { "value": "#3B2610", "type": "color", "description": "Muted warning badge background" }
    },
    "text": {
      "primary": { "value": "#FFFFFF", "type": "color", "description": "Primary white text" },
      "secondary": { "value": "#B8B0A6", "type": "color", "description": "Warm parchment secondary text" },
      "tertiary": { "value": "#7D756D", "type": "color", "description": "Muted helper copy" },
      "inverse": { "value": "#141312", "type": "color", "description": "Dark text on flame or gold badges" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "Inter, -apple-system, system-ui, sans-serif", "type": "fontFamily" }
    },
    "scale": {
      "display": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "32px", "fontWeight": 700, "lineHeight": "38px" },
      "headlineLarge": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "24px", "fontWeight": 700, "lineHeight": "30px" },
      "headlineMedium": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "20px", "fontWeight": 600, "lineHeight": "26px" },
      "title": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "17px", "fontWeight": 600, "lineHeight": "22px" },
      "bodyLarge": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "22px" },
      "bodyRegular": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px" },
      "caption": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "16px" },
      "footnote": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "11px", "fontWeight": 600, "lineHeight": "14px" }
    }
  },
  "spacing": {
    "4": { "value": "4px", "type": "dimension" },
    "8": { "value": "8px", "type": "dimension" },
    "12": { "value": "12px", "type": "dimension" },
    "16": { "value": "16px", "type": "dimension" },
    "20": { "value": "20px", "type": "dimension" },
    "24": { "value": "24px", "type": "dimension" },
    "32": { "value": "32px", "type": "dimension" },
    "40": { "value": "40px", "type": "dimension" },
    "48": { "value": "48px", "type": "dimension" },
    "64": { "value": "64px", "type": "dimension" }
  },
  "radii": {
    "button": { "value": "16px", "type": "dimension" },
    "card": { "value": "20px", "type": "dimension" },
    "chip": { "value": "999px", "type": "dimension" },
    "modal": { "value": "28px", "type": "dimension" }
  },
  "touchErgonomics": {
    "ios": { "minSize": "44px" },
    "android": { "minSize": "48px" }
  },
  "viewports": {
    "ios": { "width": 393, "height": 852, "safeAreaTop": 59, "safeAreaBottom": 34, "device": "iPhone 16 Pro" },
    "android": { "width": 412, "height": 915, "safeAreaTop": 40, "safeAreaBottom": 24, "device": "Android 15 (Pixel 9)" }
  }
}
