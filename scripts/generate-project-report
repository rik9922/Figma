#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT_DIR = path.resolve(__dirname, "..");
const PROJECTS_DIR = path.join(ROOT_DIR, "projects");

const projectName = process.argv[2];

if (!projectName) {
  console.error("❌ Error: Project name is required.");
  console.log("Usage: ./scripts/generate-project-report <project-name>");
  process.exit(1);
}

const targetDir = path.join(PROJECTS_DIR, projectName);
const configPath = path.join(targetDir, "project.config.json");

if (!fs.existsSync(configPath)) {
  console.error(`❌ Error: project.config.json missing for project: ${projectName}`);
  process.exit(1);
}

const config = JSON.parse(fs.readFileSync(configPath, "utf8"));
const status = config.workflowStatus || {};

const formatGate = (val) => (val ? "✅ Approved / Passed" : "⏳ Pending Approval");

console.log(`
======================================================
📊 PROJECT STATUS REPORT: ${config.projectName}
======================================================
- Type:           ${config.projectType}
- Platform:       ${config.targetPlatform}
- Framework:      ${config.development?.framework || "N/A"} (${config.development?.language || "N/A"})
- Figma File:     ${config.figma?.fileUrl || config.figma?.fileKey || "Not linked"}
- Visual Style:   ${config.visualDirection?.style || "Standard"}

--- 8 Mandatory Approval Gates ---
- Gate 1: Requirements:        ${formatGate(status.gate1_requirementsApproved ?? status.requirementsApproved)}
- Gate 2: Architecture:        ${formatGate(status.gate2_architectureApproved ?? status.architectureApproved)}
- Gate 3: Visual Direction:    ${formatGate(status.gate3_visualDirectionApproved ?? status.visualDirectionApproved)}
- Gate 4: Asset Approval:      ${formatGate(status.gate4_assetsApproved ?? status.assetsApproved)}
- Gate 5: Figma UI Design:     ${formatGate(status.gate5_figmaDesignApproved ?? status.figmaDesignApproved)}
- Gate 6: Prototype Studies:   ${formatGate(status.gate6_prototypeApproved ?? status.prototypeApproved)}
- Gate 7: Development Handoff: ${formatGate(status.gate7_codeImplementationApproved ?? status.codeImplementationApproved)}
- Gate 8: Final QA & Delivery: ${formatGate(status.gate8_qaPassed ?? status.qaPassed)}
======================================================
`);
