#!/usr/bin/env node
import fs from "fs";
import path from "path";
import {
  resolveProjectPath,
  loadProjectConfig,
  extractScreenIds,
} from "../tools/common/project-utils.js";

const projectName = process.argv[2];

if (!projectName) {
  console.error("❌ Error: Project name is required.");
  console.log("Usage: ./scripts/generate-project-report <project-name>");
  process.exit(1);
}

let targetDir;
let config;
try {
  targetDir = resolveProjectPath(projectName, { mustExist: true });
  config = loadProjectConfig(projectName);
} catch (err) {
  console.error(`❌ Error: ${err.message}`);
  process.exit(1);
}

const currentState = config.status || config.projectStatus || "DISCOVERING";
const history = config.lifecycle?.history || [];
const userSignOff = config.lifecycle?.userSignOff || null;

// Screen inventory count
const archPath = path.join(targetDir, "requirements", "SCREEN_ARCHITECTURE.md");
let screenCount = 0;
if (fs.existsSync(archPath)) {
  const content = fs.readFileSync(archPath, "utf8");
  const discovered = extractScreenIds(content);
  screenCount = discovered.length;
}

// Assets count
function countFiles(dir) {
  if (!fs.existsSync(dir)) return 0;
  return fs.readdirSync(dir, { withFileTypes: true }).filter((d) => !d.isDirectory() && !d.name.startsWith(".")).length;
}
const generatedCount = countFiles(path.join(targetDir, "assets", "generated"));
const approvedCount = countFiles(path.join(targetDir, "assets", "approved"));

console.log(`
======================================================
📊 PROJECT STATUS REPORT: ${config.projectName}
======================================================
- Lifecycle State:       ${currentState}
- Human Design Approval: ${currentState === "USER_APPROVED" ? "✅ Explicit User Approval Granted" : currentState === "AWAITING_USER_REVIEW" ? "⏳ Awaiting User Review" : currentState === "ON_HOLD" ? "⏸️  Project On Hold" : "In Progress (Pending User Review)"}
- Project Type:          ${config.projectType || "mobile-app"}
- Target Platform:       ${config.targetPlatform || "iOS"}
- Target Framework:      ${config.development?.framework || "N/A"} (${config.development?.language || "N/A"})
- Figma File:            ${config.figma?.fileUrl || config.figma?.fileKey || "Not linked"}
- Visual Style:          ${config.visualDirection?.style || "Standard"}

--- Project Inventories ---
- Screen & State IDs:    ${screenCount > 0 ? `${screenCount} documented` : "Pending architecture"}
- Assets Awaiting Review:${generatedCount}
- User-Approved Assets:  ${approvedCount}

--- Recent Lifecycle Transitions ---
${
  history.length > 0
    ? history
        .slice(-4)
        .map((h) => `  [${h.timestamp ? h.timestamp.split("T")[0] : "—"}] ${h.from} → ${h.to}: ${h.note || ""}`)
        .join("\n")
    : "  No state transitions recorded."
}

------------------------------------------------------
ℹ️  Authority Note: The human user is the sole design
    reviewer and approval authority.
======================================================
`);
