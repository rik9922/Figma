#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { resolveProjectPath } from "../tools/common/project-utils.js";

const projectName = process.argv[2];

if (!projectName) {
  console.error("❌ Error: Project name is required.");
  console.log("Usage: ./scripts/validate-assets <project-name>");
  process.exit(1);
}

let targetDir;
try {
  targetDir = resolveProjectPath(projectName, { mustExist: true });
} catch (err) {
  console.error(`❌ Validation failed: ${err.message}`);
  process.exit(1);
}

const assetsDir = path.join(targetDir, "assets");

if (!fs.existsSync(assetsDir)) {
  console.error(`❌ Error: Assets directory not found for project: ${projectName}`);
  process.exit(1);
}

console.log(`🖼️  Validating assets for project "${projectName}"...`);

const manifestPath = path.join(assetsDir, "manifest", "asset-manifest.md");
if (!fs.existsSync(manifestPath)) {
  console.error("❌ Error: Asset manifest missing at assets/manifest/asset-manifest.md");
  process.exit(1);
}

function scanDir(dir) {
  if (!fs.existsSync(dir)) return [];
  const files = [];
  const items = fs.readdirSync(dir, { withFileTypes: true });
  for (const item of items) {
    const full = path.join(dir, item.name);
    if (item.isDirectory()) {
      files.push(...scanDir(full));
    } else if (!item.name.startsWith(".")) {
      files.push(full);
    }
  }
  return files;
}

const generatedFiles = scanDir(path.join(assetsDir, "generated"));
const approvedFiles = scanDir(path.join(assetsDir, "approved"));

console.log(`- Generated Assets awaiting user review: ${generatedFiles.length}`);
console.log(`- User-Approved Assets ready for Figma:  ${approvedFiles.length}`);

let issues = 0;
const MAX_BYTES = 10 * 1024 * 1024; // 10MB Figma MCP upload limit

for (const f of [...generatedFiles, ...approvedFiles]) {
  const size = fs.statSync(f).size;
  const rel = path.relative(targetDir, f);
  if (size > MAX_BYTES) {
    console.error(`❌ File exceeds 10MB Figma upload limit: ${rel} (${(size / 1024 / 1024).toFixed(2)} MB)`);
    issues++;
  }
}

if (issues === 0) {
  console.log(`✅ All ${generatedFiles.length + approvedFiles.length} project asset files are valid and within Figma upload limits.`);
  process.exit(0);
} else {
  console.error(`❌ Found ${issues} asset issue(s).`);
  process.exit(1);
}
