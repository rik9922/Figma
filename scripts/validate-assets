#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT_DIR = path.resolve(__dirname, "..");
const PROJECTS_DIR = path.join(ROOT_DIR, "projects");

const projectName = process.argv[2];

if (!projectName) {
  console.error("❌ Error: Project name is required.");
  console.log("Usage: ./scripts/validate-assets <project-name>");
  process.exit(1);
}

const targetDir = path.join(PROJECTS_DIR, projectName);
const assetsDir = path.join(targetDir, "assets");

if (!fs.existsSync(assetsDir)) {
  console.error(`❌ Error: Assets directory not found for project: ${projectName}`);
  process.exit(1);
}

console.log(`🖼️  Validating assets for project "${projectName}"...`);

const manifestPath = path.join(assetsDir, "manifest", "asset-manifest.md");
if (!fs.existsSync(manifestPath)) {
  console.error("❌ Error: Asset manifest missing.");
  process.exit(1);
}

const manifestContent = fs.readFileSync(manifestPath, "utf8");

function scanDir(dir) {
  if (!fs.existsSync(dir)) return [];
  const files = [];
  const items = fs.readdirSync(dir, { withFileTypes: true });
  for (const item of items) {
    const full = path.join(dir, item.name);
    if (item.isDirectory()) {
      files.push(...scanDir(full));
    } else if (!item.name.startsWith(".")) {
      files.push(full);
    }
  }
  return files;
}

const generatedFiles = scanDir(path.join(assetsDir, "generated"));
const approvedFiles = scanDir(path.join(assetsDir, "approved"));

console.log(`- Generated Assets awaiting review: ${generatedFiles.length}`);
console.log(`- Approved Assets ready for Figma: ${approvedFiles.length}`);

let issues = 0;
const MAX_BYTES = 10 * 1024 * 1024; // 10MB Figma limit

for (const f of [...generatedFiles, ...approvedFiles]) {
  const size = fs.statSync(f).size;
  const rel = path.relative(targetDir, f);
  if (size > MAX_BYTES) {
    console.error(`❌ File exceeds 10MB Figma MCP upload limit: ${rel} (${(size / 1024 / 1024).toFixed(2)} MB)`);
    issues++;
  }
}

if (issues === 0) {
  console.log(`✅ All ${generatedFiles.length + approvedFiles.length} project assets are valid and within Figma limits.`);
  process.exit(0);
} else {
  console.error(`❌ Found ${issues} asset issue(s).`);
  process.exit(1);
}

