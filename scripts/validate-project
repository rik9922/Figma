#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { resolveProjectPath, loadProjectConfig } from "../tools/common/project-utils.js";

const projectName = process.argv[2];

if (!projectName) {
  console.error("❌ Error: Project name is required.");
  console.log("Usage: ./scripts/validate-project <project-name>");
  process.exit(1);
}

let targetDir;
let config;
try {
  targetDir = resolveProjectPath(projectName, { mustExist: true });
  config = loadProjectConfig(projectName);
} catch (err) {
  console.error(`❌ Validation failed: ${err.message}`);
  process.exit(1);
}

console.log(`🔍 Validating project "${projectName}"...`);
const errors = [];
const warnings = [];

// 1. Validate project config
if (!config.projectName) errors.push("config missing 'projectName'");
if (!config.status && !config.projectStatus) errors.push("config missing 'status'");
if (!config.targetPlatform) errors.push("config missing 'targetPlatform'");
if (!config.figma) errors.push("config missing 'figma' block");
if (!config.figma?.fileKey && !config.figma?.fileUrl) {
  warnings.push("Figma file URL / Key not yet linked in project.config.json");
}

// 2. Validate essential directories
const requiredDirs = [
  "requirements",
  "research",
  "architecture",
  "assets/generated",
  "assets/approved",
  "assets/manifest",
  "figma",
  "design-system",
  "motion",
  "revisions",
];

for (const dir of requiredDirs) {
  const fullPath = path.join(targetDir, dir);
  if (!fs.existsSync(fullPath)) {
    errors.push(`Missing directory: ${dir}`);
  }
}

// 3. Validate asset manifest
const manifestPath = path.join(targetDir, "assets", "manifest", "asset-manifest.md");
if (!fs.existsSync(manifestPath)) {
  errors.push("Missing assets/manifest/asset-manifest.md");
}

// 4. Validate revision history
const revisionPath = path.join(targetDir, "revisions", "REVISION_HISTORY.md");
if (!fs.existsSync(revisionPath)) {
  warnings.push("Missing revisions/REVISION_HISTORY.md (Recommended for tracking user reviews)");
}

console.log("-----------------------------------------");
if (errors.length === 0) {
  console.log(`✅ Project "${projectName}" structure is VALID.`);
  console.log(`   Lifecycle State: ${config.status || config.projectStatus || "DISCOVERING"}`);
  if (warnings.length > 0) {
    console.log("⚠️  Notes:");
    warnings.forEach((w) => console.log(`   - ${w}`));
  }
  process.exit(0);
} else {
  console.error(`❌ Project "${projectName}" has ${errors.length} validation error(s):`);
  errors.forEach((e) => console.error(`   - ${e}`));
  process.exit(1);
}
