#!/usr/bin/env node
import {
  updateProjectState,
  PROJECT_LIFECYCLE_STATES,
} from "../tools/common/project-utils.js";

/**
 * Authoritative Project Lifecycle State Transition Script
 *
 * Usage:
 *   ./scripts/set-project-state <project-name> <new-state> [note] [--resume] [--approved-by <user>]
 *
 * Rules Enforced:
 * - Human approval sole authority (USER_APPROVED requires explicit confirmation)
 * - ON_HOLD protection (resuming an on-hold project requires explicit --resume authorization)
 * - Timestamped transition history logging in project.config.json
 */

const args = process.argv.slice(2);
const projectName = args[0];
const newState = args[1]?.toUpperCase();

if (!projectName || !newState) {
  console.log(`
Usage: ./scripts/set-project-state <project-name> <new-state> [note] [--resume] [--approved-by <user>]

Allowed States:
  ${PROJECT_LIFECYCLE_STATES.join(", ")}

Examples:
  ./scripts/set-project-state my-project READY_FOR_DESIGN "Architecture complete"
  ./scripts/set-project-state my-project DESIGN_IN_PROGRESS "Canvas work started"
  ./scripts/set-project-state my-project AWAITING_USER_REVIEW "Presented to user"
  ./scripts/set-project-state my-project REVISION_REQUESTED "User requested darker nav"
  ./scripts/set-project-state my-project USER_APPROVED "User explicitly approved" --approved-by "User"
  ./scripts/set-project-state fintech-mobile-app DISCOVERING "Resuming project" --resume
`);
  process.exit(1);
}

const allowResume = args.includes("--resume");
let approvedBy = null;
const approvedByIndex = args.indexOf("--approved-by");
if (approvedByIndex !== -1 && args[approvedByIndex + 1]) {
  approvedBy = args[approvedByIndex + 1];
}

const noteArgs = args.slice(2).filter((a, idx, arr) => {
  if (a.startsWith("--")) return false;
  if (arr[idx - 1] === "--approved-by") return false;
  return true;
});
const note = noteArgs.join(" ") || `State updated to ${newState}`;

try {
  let userSignOff = null;
  if (newState === "USER_APPROVED") {
    userSignOff = {
      approvedBy: approvedBy || "Human User (Explicit Chat Approval)",
      timestamp: new Date().toISOString(),
      note,
    };
  }

  const updatedConfig = updateProjectState(projectName, newState, note, {
    userSignOff,
    allowResume,
  });

  console.log(`✅ Project "${projectName}" successfully transitioned to: ${newState}`);
  console.log(`   Note: ${note}`);
  if (updatedConfig.lifecycle?.userSignOff) {
    console.log(`   Sign-off: Explicitly approved by ${updatedConfig.lifecycle.userSignOff.approvedBy}`);
  }
} catch (err) {
  console.error(`❌ Transition failed: ${err.message}`);
  process.exit(1);
}
